{
  "name": "vibecode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "realtime": "tsx --env-file=.env.local src/server/realtime/server.ts",
    "seed": "tsx --tsconfig ./tsconfig.json --env-file=.env.local src/server/database/seed.ts",
    "seed:reset": "tsx --tsconfig ./tsconfig.json --env-file=.env.local src/server/database/seed.ts --reset",
    "db:sync-indexes": "tsx --tsconfig ./tsconfig.json --env-file=.env.local src/server/database/sync-indexes.ts",
    "db:cleanup-legacy": "tsx --tsconfig ./tsconfig.json --env-file=.env.local src/server/database/cleanup-legacy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "next-intl": "^4.13.5",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
